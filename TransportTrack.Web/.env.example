# URL base de la API (ej: https://transporttrack-api.up.railway.app o vacío en dev con proxy Vite)
VITE_API_BASE_URL=

# URL del hub SignalR (mismo host que la API). Vacío = usar polling como fallback.
VITE_SIGNALR_URL=

# Estilo del mapa MapLibre (URL de un style JSON). Ej: https://demotiles.maplibre.org/style.json
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Habilita el simulador de GPS para pruebas (true/false). Solo para desarrollo.
VITE_ENABLE_GPS_SIMULATOR=false

# Demo en Netlify: true emula Functions + Blobs + Database en local con @netlify/vite-plugin.
# En producción se activa automáticamente al desplegar en Netlify (netlify.toml en la raíz).
# Con false se usa la API .NET local (proxy /api -> http://localhost:5000).
VITE_USE_NETLIFY_DEMO=false